def statistics(*, reset: bool = ...) -> Statistics: ...
def set_profiling_enabled(enabled: bool) -> None: ...

class Kernel:
    @property
    def function(self) -> Callable[..., Any]: ...

class Function:
    @property
    def function(self) -> Callable[..., Any]: ...

def kernel(function: _F) -> Kernel: ...
