def bind_transform(owner: Any, *, pose: Buffer, initial_pose: TransformPose | None = ..., domain: Buffer | None = ..., points: tuple[Buffer, ...] = ..., vectors: tuple[Buffer, ...] = ..., on_transform: Callable[[TransformPose, TransformPose], None] | None = ...) -> TransformBinding:
    """Bind a simulation pose; initial_pose makes the authored Transform initialize it immediately."""
