from typing import Optional
import numpy as np
from numpy.typing import NDArray
from infernux.components.builtin_component import BuiltinComponent
from infernux.core.asset_ref import GenericAssetRef
from infernux.lib import Transform

class SkeletonInstance(BuiltinComponent):
    model: Optional[GenericAssetRef]
    @property
    def root(self) -> Optional[Transform]: ...
    @property
    def bones(self) -> list[Transform]: ...
    @property
    def bone_names(self) -> list[str]: ...
    @property
    def parent_indices(self) -> list[int]: ...
    def get_bone_transform(self, name: str) -> Optional[Transform]: ...
    def get_human_bone_transform(self, slot: str) -> Optional[Transform]: ...
    def get_bind_local_matrices(self) -> NDArray[np.float32]: ...
    def get_local_matrices(self) -> NDArray[np.float32]: ...
    def get_root_space_matrices(self) -> NDArray[np.float32]: ...
    def get_world_matrices(self) -> NDArray[np.float32]: ...
    @property
    def physics_controls_pose(self) -> bool: ...
    @property
    def has_animation_pose(self) -> bool: ...
    def capture_animation_pose(self) -> None: ...
    def apply_animation_pose(self) -> None: ...
    def get_animation_world_matrices(self) -> NDArray[np.float32]: ...
    def rebuild_hierarchy(self) -> None: ...
    def reset_to_bind_pose(self) -> None: ...
