from typing import Sequence
from infernux.components.builtin_component import BuiltinComponent
from infernux.components.builtin.rigidbody import Rigidbody
from infernux.components.builtin.skeleton_instance import SkeletonInstance
from infernux.lib import quatf

class Ragdoll(BuiltinComponent):
    @property
    def active(self) -> bool: ...
    @active.setter
    def active(self, value: bool) -> None: ...
    @property
    def drive_animation(self) -> bool: ...
    @drive_animation.setter
    def drive_animation(self, value: bool) -> None: ...
    def set_passive(self) -> None: ...
    @property
    def is_bound(self) -> bool: ...
    @property
    def bodies(self) -> list[Rigidbody]: ...
    @property
    def body_count(self) -> int: ...
    @property
    def constraint_count(self) -> int: ...
    def rebuild(self) -> bool: ...
    @property
    def skeleton(self) -> SkeletonInstance | None: ...
    @property
    def total_mass(self) -> float: ...
    @total_mass.setter
    def total_mass(self, value: float) -> None: ...
    def generate_physics(self) -> int: ...
    def drive_pose(self, world_rotations: Sequence[quatf]) -> None: ...
