from collections.abc import Buffer
from typing import Iterable, Sequence
from infernux.lib import Vector3
from .line_renderer import LineRenderer

class TrailRenderer(LineRenderer):
    time: float
    min_vertex_distance: float
    emitting: bool
    @property
    def position_count(self) -> int: ...
    @property
    def positions(self) -> list[Vector3]: ...
    def add_position(self, position: Vector3 | Sequence[float]) -> None: ...
    def add_positions(self, positions: Iterable[Vector3 | Sequence[float]] | Buffer) -> None: ...
    def set_positions(self, positions: Iterable[Vector3 | Sequence[float]] | Buffer) -> None: ...
    def clear(self) -> None: ...
