from os import PathLike
from typing import Any

class ContentPublication:
    status: str
    error: str
    asset_guids: tuple[str, ...]
    scene_guids: tuple[str, ...]
    @property
    def is_complete(self) -> bool: ...

class Application:
    @staticmethod
    def is_editor() -> bool: ...
    @staticmethod
    def is_player() -> bool: ...
    @staticmethod
    def data_path() -> str: ...
    @staticmethod
    def persistent_data_path() -> str: ...
    @staticmethod
    def publish_content(data_directory: str | PathLike[str]) -> ContentPublication: ...
    @staticmethod
    def asset_path(path: str) -> str: ...
    @staticmethod
    def package_path(package_reference: str, relative_path: str | PathLike[str]) -> str: ...
    @staticmethod
    def open_url(target: str) -> bool: ...
    @staticmethod
    def renderer_state() -> dict[str, Any]: ...
    @staticmethod
    def quit(exit_code: int = 0) -> bool: ...
