from typing import Any, Optional, TypedDict

class HingeState(TypedDict):
    motion: Any
    physics_step: int

class HingeJointBatch:
    def __init__(self, joints: Any) -> None: ...
    def __len__(self) -> int: ...
    @property
    def world_id(self) -> int: ...
    @property
    def simulation_epoch(self) -> int: ...
    def validate(self) -> None: ...
    def read_state(self, out: Any = ...) -> HingeState: ...
    def set_motor_targets(self, targets: Any, *, expected_physics_step: Optional[int] = ...) -> None: ...
