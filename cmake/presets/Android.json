{
  "version": 6,
  "configurePresets": [
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64 Release Player",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/android-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MAKE_PROGRAM": "$env{ANDROID_SDK_ROOT}/cmake/3.30.5/bin/ninja.exe",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_SDK_ROOT}/ndk/29.0.14206865/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "Python3_EXECUTABLE": "$env{CONDA_PREFIX}/python.exe",
        "INFERNUX_HOST_PYTHON_EXECUTABLE": "$env{CONDA_PREFIX}/python.exe",
        "pybind11_DIR": "$env{CONDA_PREFIX}/Lib/site-packages/pybind11/share/cmake/pybind11",
        "INFERNUX_USE_TARGET_PYTHON": "ON",
        "INFERNUX_TARGET_PYTHON_INCLUDE_DIR": "$env{INFERNUX_ANDROID_PYTHON_PREFIX_ARM64}/include/python3.13",
        "INFERNUX_TARGET_PYTHON_LIBRARY": "$env{INFERNUX_ANDROID_PYTHON_PREFIX_ARM64}/lib/libpython3.13.so",
        "INFERNUX_PYTHON_SYNC_DIR": "${sourceDir}/out/build/android-arm64-release/python-sync",
        "INFERNUX_BUILD_PLAYER_HOST": "OFF",
        "INFERNUX_BUILD_TESTS": "OFF",
        "INFERNUX_RELEASE_LTO": "OFF",
        "INFERNUX_ENABLE_VULKAN_VALIDATION": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64-player",
      "configurePreset": "android-arm64-release",
      "targets": ["prebuild_android_player"],
      "jobs": 4
    }
  ]
}
