#pragma once

namespace infernux
{

inline const ShaderSourceModule &GetSlangRayTraversalModule()
{
    static const ShaderSourceModule module{"inx_ray_traversal", "<infernux/shader/ray_traversal>", R"inxslang(
@_ray_traversal_source@)inxslang"};
    return module;
}

inline const ShaderSourceModule &GetSlangRayBsdfModule()
{
    static const ShaderSourceModule module{"inx_ray_bsdf", "<infernux/shader/ray_bsdf>", R"inxslang(
@_ray_bsdf_source@)inxslang"};
    return module;
}

} // namespace infernux
