#!/usr/bin/env sh
set -eu

if ! command -v clang-format >/dev/null 2>&1; then
  echo "[pre-push] clang-format not found in PATH."
  echo "[pre-push] Install clang-format and retry push."
  exit 1
fi

fail=0
checked=0
changed=$(mktemp)
trap 'rm -f "$changed"' EXIT HUP INT TERM
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git hash-object -t tree /dev/null)
  else
    base=$remote_sha
  fi
  git diff --name-only --diff-filter=ACMR "$base" "$local_sha" |
    while IFS= read -r file; do
      printf '%s\t%s\n' "$local_sha" "$file"
    done >>"$changed"
done

sort -u "$changed" -o "$changed"
while IFS="$(printf '\t')" read -r sha file; do
  case "$file" in
    cpp/*.cpp|cpp/*.h|cpp/*.hpp)
      checked=$((checked + 1))
      if ! git show "${sha}:${file}" |
        clang-format --dry-run --Werror --assume-filename "$file" - >/dev/null 2>&1; then
        echo "[pre-push] Format check failed: $file"
        fail=1
      fi
      ;;
  esac
done <"$changed"

if [ "$checked" -eq 0 ]; then
  exit 0
fi

if [ "$fail" -ne 0 ]; then
  echo "[pre-push] clang-format check failed. Run: cmake --build --preset format"
  exit 1
fi

echo "[pre-push] clang-format check passed ($checked files)."
