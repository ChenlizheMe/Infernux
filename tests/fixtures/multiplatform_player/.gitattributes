# Keep project text deterministic across platforms
* text=auto
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.scene text eol=lf merge=text
*.prefab text eol=lf merge=text
*.mat text eol=lf merge=text
*.effect text eol=lf merge=text
*.effectgroup text eol=lf merge=text
*.particlegraph text eol=lf merge=text
*.physicmaterial text eol=lf merge=text
*.rendertexture text eol=lf merge=text
*.inxdata text eol=lf merge=text
*.animclip2d text eol=lf merge=text
*.animclip3d text eol=lf merge=text
*.animfsm text eol=lf merge=text
*.timelinefsm text eol=lf merge=text
*.animtimeline text eol=lf merge=text
*.meta text eol=lf merge=text
**/ProjectSettings/*.json text eol=lf merge=text
**/InxPlugins.json text eol=lf merge=text

# Authored engine documents use the installed Infernux semantic merge driver.
# Objects, components, graph nodes and fields retain their semantic identities.

# Binary assets must never receive line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.dds binary
*.ktx binary
*.ktx2 binary
*.fbx binary
*.glb binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.inxpkg binary
