# Infernux generated asset cache and imported artifacts
/Library/

# Temporary editor/runtime data
/Temp/
/Logs/
/Cache/

# Project-local Python runtimes
/.runtime/
/.venv/

# Package manager staging is disposable; Packages source files are tracked.
/Packages/.staging/
/Packages/.cache/

# Game build outputs
/Build/
/Builds/
/Dist/
/Export/
/Exports/

# Per-machine engine state and process locks
/.infernux-engine-lock.guard
/ProjectSettings/.infernux-engine-lock.*
# Obsolete editor preferences are private and no longer read by the engine.
/ProjectSettings/EditorSettings.json
/ProjectSettings/GameView.ini
/.infernux-backups/
/.infernux-runtime-rollback-*/
/pyrightconfig.json
/ProjectSettings/requirements.txt.migrate-*

# Python bytecode caches; native .pyd plugin payloads are project inputs.
__pycache__/
*.pyc
*.pyo
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Temporary asset sidecars (asset .meta files must remain tracked)
!*.meta
*.meta.tmp
*.tmp
*.bak
*.orig

# IDE state
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Runtime diagnostics
*.log
*.dmp
*.stackdump

# Project-local ImGui state
imgui.ini
