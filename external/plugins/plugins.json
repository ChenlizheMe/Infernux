{
  "$schema": "infernux.official_plugin_sources",
  "plugins": [
    {
      "path": "infernux_mcp",
      "repository": "https://github.com/ChenlizheMe/infernux_mcp",
      "category": "editor_tools",
      "targets": [],
      "default": true
    },
    {
      "path": "infernux_taichi",
      "repository": "https://github.com/ChenlizheMe/infernux_taichi",
      "category": "compute",
      "targets": [],
      "default": false
    },
    {
      "path": "infernux_windows",
      "repository": "https://github.com/ChenlizheMe/infernux_windows",
      "category": "platform_build",
      "targets": [
        "windows-x64"
      ],
      "default": false
    },
    {
      "path": "infernux_linux",
      "repository": "https://github.com/ChenlizheMe/infernux_linux",
      "category": "platform_build",
      "targets": [
        "linux-x64"
      ],
      "default": false
    },
    {
      "path": "infernux_android",
      "repository": "https://github.com/ChenlizheMe/infernux_android",
      "category": "platform_build",
      "targets": [
        "android-arm64",
        "android-x64-emulator"
      ],
      "default": false
    },
    {
      "path": "infernux_web",
      "repository": "https://github.com/ChenlizheMe/infernux_web",
      "category": "platform_build",
      "targets": [
        "web-wasm32"
      ],
      "default": false
    }
  ]
}
